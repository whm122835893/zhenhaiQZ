# 后端环境变量模板
#
# 用法：cp .env.example .env 后按需填写。
# ⚠️ .env 含 JWT_SECRET / DB_PASS / RSA_PRIVATE_KEY，已被 .gitignore 排除，勿提交。
#
# 密钥生成：
#   RSA 密钥对：openssl genpkey -algorithm RSA -out rsa.pem -pkeyopt rsa_keygen_bits:2048
#   RSA 公钥：php scripts/export_public_key.php
APP_DEBUG =
APP_TRACE =
APP_DEFAULT_TIMEZONE =
DEFAULT_LANG =
APP_ID =
APP_VERSION =
DB_DRIVER =
DB_TYPE =
DB_HOST =
DB_NAME =
DB_USER =
DB_PASS =
DB_PORT =
DB_CHARSET =
DB_PREFIX =
JWT_SECRET =
JWT_TTL =
JWT_ISSUER =
RSA_PRIVATE_KEY =
RSA_PUBLIC_KEY =
MEDIA_BASE =

